# ============================================================================
# Variables de entorno de CarWash Pro - Backend
# ============================================================================
# Copia este archivo como ".env" (mismo directorio) y coloca tus propios
# valores. El archivo ".env" NUNCA se sube a git (ver .gitignore).
#
# Pasos rápidos para desarrollo local con MySQL Workbench:
#   1. Ejecuta backend/database/schema.sql en tu servidor MySQL local.
#   2. (Opcional) Ejecuta backend/database/datos_semilla.sql para tener
#      datos de prueba, incluyendo el usuario admin/admin123.
#   3. Completa DB_USER y DB_PASSWORD con las credenciales de tu MySQL local.
#   4. npm install && npm start
# ============================================================================

# Puerto donde corre el servidor Express (Railway lo sobreescribe solo)
PORT=3000

# Conexión a MySQL (local vía Workbench, o remota en Railway/PlanetScale/etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carwash_pro

# Secreto usado para firmar los tokens de sesión (JWT). Cambia este valor
# por una cadena larga y aleatoria propia antes de desplegar a producción.
JWT_SECRET=cambia-este-valor-por-una-clave-larga-y-aleatoria
JWT_EXPIRA_EN=8h

# Origen permitido para peticiones CORS del frontend (usa * en desarrollo)
CORS_ORIGEN=*
